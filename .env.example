# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=tictactoe
DB_PASSWORD=tictactoe123
DB_NAME=tictactoe

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Backend Configuration
PORT=8080

# Frontend Configuration (for Docker build)
# Passed as VITE_API_BASE_URL build arg to the frontend container
API_URL=http://localhost:8080/api/v1

# CORS Configuration
# Comma-separated list of allowed origins for the backend
CORS_ALLOWED_ORIGINS=http://localhost

# Caddy Reverse Proxy
# Set to your nip.io address: tictactoe.<your-lightsail-ip>.nip.io
CADDY_DOMAIN=tictactoe.0.0.0.0.nip.io
